# Copie para .env e preencha. O .env NUNCA vai para o git.
#
# Use uma CONTA DE SERVIÇO do SQL Server, não a conta pessoal de um usuário:
# a senha fica em texto no .env e o app cai quando a pessoa troca a senha.
# A conta não deve ser sysadmin.

# Porta da API. Na VM de portais: 3004 (3000-3003 já são dos outros).
API_PORT=

# Interface onde a API escuta. Padrão 127.0.0.1.
# Na VM, deixe em 127.0.0.1: quem conecta é o cloudflared, no mesmo host, e o
# que não é alcançável pela rede não tem como ter o X-Forwarded-For forjado.
# Use 0.0.0.0 só para expor direto na rede, sem túnel — e aí TRUST_PROXY tem
# que sair junto, senão o limite de tentativas vira decorativo.
API_HOST=

# Em quem confiar para dizer o IP real do visitante. Padrão `loopback`, que é o
# certo atrás do Cloudflare Tunnel. Vazio = usa o padrão.
TRUST_PROXY=loopback

# Origens adicionais autorizadas a alterar dados, separadas por vírgula.
# Normalmente pode ficar vazio: o Host público recebido pelo Express já é
# aceito. Preencha apenas se o portal for acessado por mais de uma origem.
APP_ORIGINS=

# --- SQL Server (KINGEJOE) --------------------------------------------------
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=KINGEJOE
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Instância on-premise sem certificado assinado por CA pública.
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERTIFICATE=true
SQLSERVER_TIMEOUT=30000

# --- Objetos de origem (somente SELECT; nunca alterar tabela do ERP) --------
# Os valores abaixo são os confirmados na KINGEJOE. Sem eles o código usa esses
# mesmos padrões; a variável existe para poder apontar para outro objeto sem
# mexer no código.

# Visão contábil do Linx que fornece as classificações do portal.
# Na KINGEJOE é a 07 (estrutura gerencial, códigos com ponto).
DB_VISAO_CONTABIL=25

DB_VIEW_CONTAS=dbo.CTB_VISAO
DB_VIEW_FILIAIS=dbo.FILIAIS
DB_VIEW_CENTROS=dbo.CTB_CENTRO_CUSTO
DB_TABELA_LANCAMENTO=dbo.CTB_LANCAMENTO
DB_TABELA_LANCAMENTO_ITEM=dbo.CTB_LANCAMENTO_ITEM

# --- Active Directory (login) ----------------------------------------------
# O AD valida o primeiro acesso. Depois a pessoa define uma senha própria do
# portal, armazenada apenas como hash scrypt; a senha do Windows nunca é gravada.
# Contas de origem AD continuam sendo conferidas no login e a cada renovação de
# sessão, então desativá-las no diretório também corta a senha local.
#
# Use ldaps:// (636). Em ldap:// puro a senha trafega em texto claro na rede.
LDAP_URL=ldaps://SEU-DC:636
LDAP_BASE_DN=DC=exemplo,DC=local

# Onde procurar usuários. Vazio = usa o LDAP_BASE_DN.
LDAP_SEARCH_BASE=

# Conta de serviço SÓ-LEITURA, usada para procurar usuários e confirmar se uma
# conta de origem AD continua ativa. Nunca valida a senha de ninguém.
LDAP_BIND_DN=servico.portal@exemplo.local
LDAP_BIND_PASSWORD=

# Domínio para montar `usuario@dominio` quando a pessoa digita só o login.
# Vazio = deriva do LDAP_BASE_DN (DC=exemplo,DC=local -> exemplo.local).
LDAP_DOMAIN=

# Certificado do DC assinado por CA interna: deixe `false` só se o Node não
# confiar na cadeia. O correto é instalar a CA na máquina.
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Sessão ----------------------------------------------------------------
# Quem entra como administrador do portal no primeiro login, mesmo sem linha na
# tabela de acesso. Sem isto ninguém consegue conceder a primeira permissão.
# Separe por vírgula.
PORTAL_ADMINS=
