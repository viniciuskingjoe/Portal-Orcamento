# Copie para .env e preencha. O .env NUNCA vai para o git.
#
# Use uma CONTA DE SERVIÇO do SQL Server, não a conta pessoal de um usuário:
# a senha fica em texto no .env e o app cai quando a pessoa troca a senha.
# A conta não deve ser sysadmin.

API_PORT=3000

DB_HOST=
DB_NAME=KINGEJOE
DB_USER=
DB_PASS=
DB_PORT=1433

# Instância interna com certificado próprio: a conexão continua criptografada,
# mas o certificado não é validado. Em instância com certificado válido, use false.
DB_ENCRYPT=true
DB_TRUST_CERT=true
DB_TIMEOUT=30000

# Views de origem (somente SELECT — nunca alterar tabela do ERP).
# Sem estas variáveis a rota correspondente responde 503 dizendo o que falta.
DB_VIEW_CONTAS=
DB_VIEW_FILIAIS=
DB_VIEW_CENTROS=
DB_VIEW_REALIZADO=
